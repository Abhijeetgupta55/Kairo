<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>kairo. - recents</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #ffffff;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      line-height: 1.6;
      background-image:
        linear-gradient(to right, #d8d8d886 1px, transparent 1px),
        linear-gradient(to bottom, #d8d8d886 1px, transparent 1px);
      background-size: 20px 20px;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: 
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.482) 0%, transparent 40%),
        radial-gradient(circle at 90% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
      z-index: 1000;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 5px;
      transition: all 0.3s;
    }

    .hamburger:hover { opacity: 0.7; }

    .hamburger span {
      width: 25px;
      height: 3px;
      background: #ffffff;
      border-radius: 3px;
      transition: all 0.3s ease;
    }

    .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(8px, 8px); }
    .hamburger.active span:nth-child(2) { opacity: 0; }
    .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(7px, -7px); }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 600;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.5px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .logout-btn {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      padding: 0.5rem 1rem;
      border-radius: 10px;
    }

    .logout-btn:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.1);
    }

    .profile-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #ffffff93;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
    }

    .profile-icon:hover {
      transform: scale(1.1);
      box-shadow: 0 0 0 3px rgba(185, 185, 185, 0.3);
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: -300px;
      width: 300px;
      height: 100vh;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 2px 0 30px rgba(0, 0, 0, 0.3);
      transition: left 0.3s ease;
      z-index: 999;
      padding-top: 80px;
    }

    .sidebar.active { left: 0; }

    .sidebar-links {
      display: flex;
      flex-direction: column;
    }

    .sidebar-links a {
      padding: 1.2rem 2rem;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .sidebar-links a:hover {
      background: rgba(255, 255, 255, 0.1);
      border-left-color: #ffffff;
      color: #ffffff;
    }

    .overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(232, 232, 232, 0.605);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 998;
      backdrop-filter: blur(5px);
    }

    .overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .container {
      padding: 100px 3rem 3rem;
      max-width: 1400px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
      min-height: calc(100vh - 200px);
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-header h1 {
      font-size: 2rem;
      color: #000;
      margin-bottom: 1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .search-bar {
      position: relative;
      max-width: 600px;
      margin-bottom: 2rem;
      
    }

    .search-bar input {
      width: 100%;
      padding: 1rem 1rem 1rem 3rem;
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 12px;
      font-family: 'Inter', sans-serif;
      color: #000;
      font-size: 0.95rem;
      transition: all 0.3s;
    }

    .search-bar input:focus {
      outline: none;
      border-color: rgba(59, 130, 246, 0.5);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
      background: #fff;
    }
    .search-bar::before {
      content: '';
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.1rem;
    }

    .recents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .recent-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.3s;
      cursor: pointer;
      position: relative;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .recent-card:hover {
      background: linear-gradient(135deg, rgba(173, 216, 230, 0.3) 0%, rgba(135, 206, 235, 0.2) 100%);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(135, 206, 235, 0.3);
      border-color: rgba(135, 206, 235, 0.4);
    }

    .recent-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 0.8rem;
    }

    .recent-title-wrapper {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex: 1;
    }

    .recent-emoji {
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .recent-title {
      font-size: 1rem;
      font-weight: 500;
      color: #000;
      margin-bottom: 0.3rem;
      flex: 1;
    }

    .star {
      cursor: pointer;
      font-size: 1.2rem;
      color: rgba(0, 0, 0, 0.3);
      transition: all 0.3s;
      flex-shrink: 0;
      margin-left: 0.5rem;
    }

    .star:hover {
      color: gold;
      transform: scale(1.2);
    }

    .star.active {
      color: gold;
    }

    .recent-url {
      font-size: 0.85rem;
      color: rgba(0, 0, 0, 0.5);
      text-decoration: none;
      word-break: break-all;
      display: block;
      margin-bottom: 0.8rem;
    }

    .recent-url:hover {
      color: rgba(0, 0, 0, 0.8);
    }

    .recent-timestamp {
      font-size: 0.8rem;
      color: rgba(0, 0, 0, 0.4);
    }

    .page-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .clear-history-btn {
      background: rgba(255, 68, 68, 0.1);
      color: #ff4444;
      border: 1px solid rgba(255, 68, 68, 0.3);
      padding: 0.6rem 1.2rem;
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s;
    }

    .clear-history-btn:hover {
      background: rgba(255, 68, 68, 0.2);
      border-color: rgba(255, 68, 68, 0.5);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(255, 68, 68, 0.2);
    }

    .view-history {
      display: block;
      margin: 0 auto;
      text-align: center;
      background: rgba(0, 0, 0, 0.95);
      color: #fff;
      padding: 1rem 2rem;
      border-radius: 12px;
      width: max-content;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: all 0.3s;
    }

    .view-history:hover {
      background: #000;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    }

    .no-results {
      text-align: center;
      padding: 3rem;
      color: rgba(0, 0, 0, 0.5);
      font-size: 1.1rem;
      grid-column: 1 / -1;
    }

    footer {
      position: relative;
      text-align: center;
      padding: 2rem;
      color: rgba(255, 255, 255, 0.8);
      margin-top: 3rem;
      z-index: 1;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.3);
    }

    @media (max-width: 768px) {
      .container {
        padding: 100px 1.5rem 2rem;
      }

      .recents-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <nav>
    <div class="nav-left">
      <div class="hamburger" onclick="toggleSidebar()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <a href="/dashboard" class="nav-logo">kairo.</a>
    </div>
    <div class="nav-right">
      <a href="/logout" class="logout-btn">logout</a>
      <a href="/profile" class="profile-icon">{{substring user.username 0 1}}</a>
    </div>
  </nav>

  <div class="sidebar" id="sidebar">
    <div class="sidebar-links">
      <a href="/dashboard">dashboard</a>
      <a href="/history">recents</a>
      <a href="/notes">notes</a>
      <a href="/favorites">favorites</a>
      <a href="/collections">collections</a>
      <a href="/profile">profile</a>
    </div>
  </div>

  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <div class="container">
    <div class="page-header">
      <div class="page-header-row">
        <h1><span class="icon">›</span> Recents</h1>
        <button class="clear-history-btn" onclick="clearHistory()">Clear History</button>
      </div>
      <div class="search-bar">
        <input type="text" id="searchInput" placeholder="search recent items...">
      </div>
    </div>

    <div class="recents-grid" id="recentsGrid">
      {{#each history}}
      <div class="recent-card" data-title="{{this.itemReference}}" data-url="{{this.details.url}}" data-id="{{this._id}}" data-favorite="{{this.isFavorite}}">
        <div class="recent-header">
          <div class="recent-title-wrapper">
            <span class="recent-emoji">🔗</span>
            <h3 class="recent-title">{{this.itemReference}}</h3>
          </div>
          <div class="star {{#if this.isFavorite}}active{{/if}}" onclick="toggleStar(this, '{{this.details.url}}', '{{this.itemReference}}')">{{#if this.isFavorite}}★{{else}}☆{{/if}}</div>
        </div>
        <a href="{{this.details.url}}" target="_blank" rel="noopener noreferrer"
          class="recent-url">{{this.details.url}}</a>
        <div class="recent-timestamp">{{timeAgo this.timestamp}}</div>
      </div>
      {{/each}}
      
    </div>
    
    {{#unless history}}
    <div class="no-results">
      no recent links yet. start adding links to collections or favorites!
    </div>
    {{/unless}}

    <div id="noResults" class="no-results" style="display: none;">
      no results found for your search
    </div>
  </div>

  <footer>
    <p>©2025 kairo. All rights reserved.</p>
  </footer>

  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      const hamburger = document.querySelector('.hamburger');
      
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
      hamburger.classList.toggle('active');
    }

    async function toggleStar(el, url, title) {
      const isActive = el.classList.contains('active');
      
      try {
        if (!isActive) {
          // Add to favorites
          const response = await fetch('/favorites/api', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ title, url, star: true })
          });
          
          const data = await response.json();
          
          if (response.ok) {
            el.classList.add('active');
            el.textContent = '★';
            el.closest('.recent-card').dataset.favorite = 'true';
          } else if (response.status === 400 && data.message.includes('already in your favorites')) {
            // Already in favorites, just update UI
            el.classList.add('active');
            el.textContent = '★';
            el.closest('.recent-card').dataset.favorite = 'true';
          } else {
            alert(data.message || 'Failed to add to favorites');
          }
        } else {
          // Remove from favorites - need to find favorite by URL
          const favResponse = await fetch('/favorites/api');
          const favorites = await favResponse.json();
          const favorite = favorites.find(f => f.url === url);
          
          if (favorite) {
            const deleteResponse = await fetch(`/favorites/api/${favorite._id}`, {
              method: 'DELETE'
            });
            
            if (deleteResponse.ok) {
              el.classList.remove('active');
              el.textContent = '☆';
              el.closest('.recent-card').dataset.favorite = 'false';
            } else {
              alert('Failed to remove from favorites');
            }
          }
        }
      } catch (error) {
        console.error('Error toggling favorite:', error);
        alert('An error occurred');
      }
    }

    async function clearHistory() {
      if (!confirm('Are you sure you want to clear all history? This action cannot be undone.')) {
        return;
      }

      try {
        const response = await fetch('/history/api', {
          method: 'DELETE'
        });

        if (response.ok) {
          // Reload page to show empty history
          window.location.reload();
        } else {
          alert('Failed to clear history');
        }
      } catch (error) {
        console.error('Error clearing history:', error);
        alert('An error occurred while clearing history');
      }
    }

    // Search functionality
    const searchInput = document.getElementById('searchInput');
    const recentsGrid = document.getElementById('recentsGrid');
    const noResults = document.getElementById('noResults');

    searchInput.addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase();
      const cards = recentsGrid.querySelectorAll('.recent-card');
      let hasResults = false;

      cards.forEach(card => {
        const title = (card.dataset.title || '').toLowerCase();
        const url = (card.dataset.url || '').toLowerCase();

        if (title.includes(searchTerm) || url.includes(searchTerm)) {
          card.style.display = 'block';
          hasResults = true;
        } else {
          card.style.display = 'none';
        }
      });

      if (cards.length === 0) {
        hasResults = false;
      }

      recentsGrid.style.display = hasResults ? 'grid' : 'none';
      noResults.style.display = hasResults ? 'none' : 'block';
    });
  </script>
</body>

</html>