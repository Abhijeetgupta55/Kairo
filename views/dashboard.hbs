<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>kairo. - Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #ffffff;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      line-height: 1.6;
      background-image:
        linear-gradient(to right, #d8d8d886 1px, transparent 1px),
        linear-gradient(to bottom,#d8d8d886 1px, transparent 1px);
      background-size: 20px 20px;
      padding-bottom: 80px; /* Space for fixed footer */
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: 
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.482) 0%, transparent 40%),
        radial-gradient(circle at 90% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
      z-index: 1000;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 5px;
      transition: all 0.3s;
    }

    .hamburger:hover { opacity: 0.7; }

    .hamburger span {
      width: 25px;
      height: 3px;
      background: #ffffff;
      border-radius: 3px;
      transition: all 0.3s ease;
    }

    .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(8px, 8px); }
    .hamburger.active span:nth-child(2) { opacity: 0; }
    .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(7px, -7px); }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 600;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.5px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .logout-btn {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      padding: 0.5rem 1rem;
      border-radius: 10px;
    }

    .logout-btn:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.1);
    }

    .profile-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #ffffff93;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
    }

    .profile-icon:hover {
      transform: scale(1.1);
      box-shadow: 0 0 0 3px rgba(185, 185, 185, 0.3);
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: -300px;
      width: 300px;
      height: 100vh;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 2px 0 30px rgba(0, 0, 0, 0.3);
      transition: left 0.3s ease;
      z-index: 999;
      padding-top: 80px;
    }

    .sidebar.active { left: 0; }

    .sidebar-links {
      display: flex;
      flex-direction: column;
    }

    .sidebar-links a {
      padding: 1.2rem 2rem;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .sidebar-links a:hover {
      background: rgba(255, 255, 255, 0.1);
      border-left-color: #ffffff;
      color: #ffffff;
    }

    .overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(232, 232, 232, 0.605);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 998;
      backdrop-filter: blur(5px);
    }

    .overlay.active {
      opacity: 1;
      visibility: visible;
    }

    /* Dashboard Layout */
    .dash-container {
      padding: 100px 3rem 3rem;
      max-width: 1400px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* Main Content Area */
    .content-wrapper {
      display: grid; 
      grid-template-columns: 2fr 1fr; /* Asymmetrical layout */
      gap: 2.5rem;
      margin-bottom: 2.5rem;
      align-items: start;
    }

    /* Left Column (Main) */
    .main-column {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    /* Right Column (Sidebar) - Full Height */
    .sidebar-column {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      height: 100%;
    }
    
    .sidebar-column .section-box {
      height: 100%;
    }

    .section-box {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(250, 250, 252, 0.95) 100%);
      backdrop-filter: blur(20px);
      border: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 16px;
      padding: 2rem;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .section-box:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
      border-color: rgba(0, 0, 0, 0.2);
    }
    
    /* NEW: Add URL Prompt Tile */
    .add-url-prompt-tile {
      cursor: pointer;
      background: linear-gradient(135deg, rgba(0, 27, 56, 0.05) 0%, rgba(139, 92, 246, 0.08) 100%);
      border: 1.5px solid rgba(99, 102, 241, 0.2);
    }
    .add-url-prompt-tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(146, 146, 146, 0);
      border-color: rgba(99, 102, 241, 0.4);
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.05)0%, rgba(139, 92, 246, 0.12) 100%);
    }
    .add-url-prompt-tile .section-title {
      border-bottom: none; 
      margin-bottom: 0.5rem;
    }
    .add-url-prompt-text {
      font-size: 0.95rem;
      color: rgba(0, 0, 0, 0.6);
      padding-left: 2.2rem; /* Align with title */
    }
    /* END NEW STYLES */


    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1.5px solid rgba(0, 0, 0, 0.1);
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .section-title .icon {
      font-size: 1.3rem;
      color: rgba(0, 0, 0, 0.7);
      font-weight: 500;
      line-height: 1; /* Aligns symbols better */
    }

    .section-title h3 {
      font-size: 1.2rem;
      color: #000;
      font-weight: 600;
    }
    
    .view-all-link, .add-new-btn {
      color: rgba(0, 0, 0, 0.5);
      text-decoration: none;
      font-size: 0.9rem;
      transition: all 0.3s;
      cursor: pointer;
    }
    .section-box:hover .view-all-link,
    .section-box:hover .add-new-btn {
      opacity: 1;
      color: rgba(0, 0, 0, 0.7);
    }
    .view-all-link:hover,
    .add-new-btn:hover {
      color: #000;
    }
    .add-new-btn {
      font-size: 1.5rem;
      font-weight: 500;
      line-height: 1;
    }
    .header-controls {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .items-list {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .item {
      padding: 1rem 1.2rem;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 10px;
      color: rgba(0, 0, 0, 0.85);
      transition: all 0.3s;
      cursor: pointer;
      font-size: 0.95rem;
    }

    .item:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: translateX(5px);
      border-color: rgba(0, 0, 0, 0.25);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .notes-box {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(250, 250, 252, 0.95) 100%);
      backdrop-filter: blur(20px);
      border: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 16px;
      padding: 2rem;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .notes-box:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
      border-color: rgba(0, 0, 0, 0.2);
    }

    .note-item {
      padding: 1rem 1.2rem;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 10px;
      color: rgba(0, 0, 0, 0.85);
      transition: all 0.3s;
      cursor: pointer;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .note-item:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: translateX(5px);
      border-color: rgba(0, 0, 0, 0.25);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Collections Tags */
    .collections-box {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(250, 250, 252, 0.95) 100%);
      backdrop-filter: blur(20px);
      border: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 16px;
      padding: 2rem;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .collections-box:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
      border-color: rgba(0, 0, 0, 0.2);
    }

    .tags-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .collection-tag {
      padding: 0.7rem 1.3rem;
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 25px;
      color: rgba(0, 0, 0, 0.85);
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.3s;
      font-weight: 500;
    }

    .collection-tag:hover {
      background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(248, 250, 255, 1) 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
      border-color: rgba(0, 0, 0, 0.25);
    }

    
    /* Enhanced Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(10px);
      align-items: center;
      justify-content: center;
      z-index: 1001;
    }

    .modal-content {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.1);
      padding: 2.5rem;
      border-radius: 20px;
      max-width: 550px;
      width: 90%;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .modal-header h2 {
      color: #000;
      font-size: 1.5rem;
    }

    .close {
      font-size: 1.8rem;
      cursor: pointer;
      color: rgba(0, 0, 0, 0.5);
      transition: color 0.3s;
      line-height: 1;
    }

    .close:hover {
      color: #000;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      color: rgba(0, 0, 0, 0.7);
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    .modal-input {
      width: 100%;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      font-family: 'Inter', sans-serif;
      color: #000;
      transition: all 0.3s;
      font-size: 0.95rem;
    }

    .modal-input:focus {
      outline: none;
      border-color: rgba(59, 130, 246, 0.5);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
      background: #fff;
    }

    .modal-select {
      width: 100%;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      font-family: 'Inter', sans-serif;
      color: #000;
      transition: all 0.3s;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .modal-select:focus {
      outline: none;
      border-color: rgba(59, 130, 246, 0.5);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
      background: #fff;
    }

    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .checkbox-item {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .checkbox-item input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    .checkbox-item label {
      color: rgba(0, 0, 0, 0.7);
      font-size: 0.95rem;
      cursor: pointer;
      margin: 0;
      font-weight: 400;
    }

    .modal-actions {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }

    .btn-primary {
      flex: 1;
      background: #000;
      color: #fff;
      border: none;
      padding: 1rem;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 500;
      font-size: 1rem;
      transition: all 0.3s;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .btn-secondary {
      flex: 1;
      background: rgba(0, 0, 0, 0.05);
      color: #000;
      border: 1px solid rgba(0, 0, 0, 0.1);
      padding: 1rem;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 500;
      font-size: 1rem;
      transition: all 0.3s;
    }

    .btn-secondary:hover {
      background: rgba(0, 0, 0, 0.1);
      transform: translateY(-2px);
    }

    .modal-box {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.1);
      padding: 2rem;
      border-radius: 20px;
      max-width: 400px;
      width: 90%;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      text-align: center;
    }

    .modal-box p {
      color: #000;
      margin-bottom: 1.5rem;
      font-size: 1.1rem;
    }

    .modal-box .btn-primary,
    .modal-box .btn-secondary {
      display: inline-block;
      padding: 0.8rem 2rem;
      text-decoration: none;
      margin: 0.5rem;
      flex: none;
    }

    footer {
      position:absolute;
      bottom: 0;       
      left: 0;         
      right: 0;        
      text-align: center;
      padding: 2rem;
      color: rgba(255, 255, 255, 0.8);
      z-index: 1;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.3);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .content-wrapper {
        grid-template-columns: 1fr; /* 1 column on tablets */
      }
    }

    @media (max-width: 768px) {
      .dash-container {
        padding: 100px 1.5rem 2rem;
      }
      /* .profile-section removed */
    }
  </style>
</head>

<body>
  <nav>
    <div class="nav-left">
      <div class="hamburger" onclick="toggleSidebar()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <a href="#" class="nav-logo">kairo.</a>
    </div>
    <div class="nav-right">
      <a href="#logoutModal" class="logout-btn">Logout</a>
      <a href="/profile" class="profile-icon">{{#if user.username}}{{substring user.username 0 1}}{{else}}B{{/if}}</a>
    </div>
  </nav>

  <div class="sidebar" id="sidebar">
    <div class="sidebar-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/history">Recents</a>
      <a href="/notes">Notes</a>
      <a href="/favorites">Favorites</a>
      <a href="/collections">Collections</a>
      <a href="/profile">Profile</a>
    </div>
  </div>

  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <div class="dash-container">
    
    <div class="content-wrapper">
      
      <div class="main-column">
        
        <div class="section-box add-url-prompt-tile" onclick="document.getElementById('addUrlModal').style.display='flex'">
          <div class="section-title">
            <span class="icon">+</span>
            <h3>Add New URL</h3>
          </div>
          <p class="add-url-prompt-text">Click here to save a new link to your dashboard.</p>
        </div>
<div class="notes-box">
          <div class="section-header">
            <div class="section-title">
              <span>◼️</span>
              <h3>Notes</h3>
            </div>
            <a href="/notes" class="view-all-link">View All →</a>
          </div>
          <div class="items-list" id="notes-list">
            {{#if recentNotes}}
              {{#each recentNotes}}
                <div class="note-item">{{this.title}}</div>
              {{/each}}
            {{else}}
              <div class="item" style="color: #999; text-align: center; padding: 2rem 1rem;">
                📝 No notes yet. <a href="/notes" style="color: #4A90E2; text-decoration: none;">Create your first note</a>
              </div>
            {{/if}}
          </div>
        </div>

        <div class="section-box">
          <div class="section-header">
            <div class="section-title">
              <span class="icon">★</span>
              <h3>Favorites</h3>
            </div>
            <a href="/favorites" class="view-all-link">View All →</a>
          </div>
          <div class="items-list" id="favorites-list">
            {{#if favoritesCount}}
              <div class="item">Loading favorites...</div>
            {{else}}
              <div class="item" style="color: #999; text-align: center; padding: 2rem 1rem;">
                ⭐ No favorites yet. <a href="/favorites" style="color: #4A90E2; text-decoration: none;">Add your first favorite</a>
              </div>
            {{/if}}
          </div>
        </div>

        <div class="collections-box">
          <div class="section-header">
            <div class="section-title">
              <span class="icon">+</span>
              <h3>Collections</h3>
            </div>
            <a href="/collections" class="view-all-link">View All →</a>
          </div>
          <div class="tags-grid" id="collections-grid">
            {{#if recentCollections}}
              {{#each recentCollections}}
                <div class="collection-tag">{{this.icon}} {{this.name}}</div>
              {{/each}}
            {{else}}
              <div style="color: #999; text-align: center; padding: 2rem 1rem; grid-column: 1/-1;">
                📚 No collections yet. <a href="/collections" style="color: #4A90E2; text-decoration: none;">Create your first collection</a>
              </div>
            {{/if}}
          </div>
        </div>
      </div>

      <div class="sidebar-column">
        <div class="section-box">
          <div class="section-header">
            <div class="section-title">
              <span class="icon">›</span>
              <h3>Recents</h3>
            </div>
            <div class="header-controls">
              <a href="/history" class="view-all-link">View All →</a>
            </div>
          </div>
          <div class="items-list" id="recents-list">
             </div>
        </div>

      </div>

    </div>
  </div>

  <div id="addUrlModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Add New URL</h2>
        <span class="close" onclick="document.getElementById('addUrlModal').style.display='none'">&times;</span>
      </div>
      
      <form id="addUrlForm">
        <div class="form-group">
          <label>Title</label>
          <input type="text" placeholder="Enter link title..." class="modal-input" id="modalTitleInput">
        </div>

        <div class="form-group">
          <label>URL</label>
          <input type="url" placeholder="https://example.com" class="modal-input" id="modalUrlInput" required>
        </div>

        <div class="form-group">
          <label>Add to Collection (optional)</label>
          <select class="modal-select">
            <option value="">Select a collection...</option>
            <option value="research">Research</option>
            <option value="music">Music</option>
            <option value="portfolio">Portfolio Inspo</option>
            <option value="ui">UI Ideas</option>
            <option value="reading">Reading List</option>
            <option value="tutorials">Tutorials</option>
          </select>
        </div>

        <div class="form-group">
          <label>Quick Actions</label>
          <div class="checkbox-group">
            <div class="checkbox-item">
              <input type="checkbox" id="addFavorites">
              <label for="addFavorites">Add to favorites</label>
            </div>
          </div>
          <p style="color: rgba(0, 0, 0, 0.5); font-size: 0.85rem; margin-top: 0.5rem;">* URLs are automatically added to recents</p>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-secondary" onclick="document.getElementById('addUrlModal').style.display='none'">Cancel</button>
          <button type="submit" class="btn-primary">Save Link</button>
        </div>
      </form>
    </div>
  </div>
 
  <div id="logoutModal" class="modal">
        <div class="modal-box">
      <p>Are you sure you want to logout?</p>
      <a href="/logout" class="btn-primary">Yes, Logout</a>
      <a href="#" class="btn-secondary" onclick="document.getElementById('logoutModal').style.display='none'; return false;">Cancel</a>
    </div>
  </div>

  <footer>
    <p>©2025 kairo. All rights reserved.</p>
  </footer>
  
  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      const hamburger = document.querySelector('.hamburger');
      
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
      hamburger.classList.toggle('active');
    }

    // --- JAVASCRIPT LOGIC ---

    // const addUrlBtn = document.getElementById('addUrlBtn'); <-- REMOVED
    const addUrlModal = document.getElementById('addUrlModal');
    const addUrlForm = document.getElementById('addUrlForm');
    const recentsList = document.getElementById('recents-list');
    const modalTitleInput = document.getElementById('modalTitleInput');
    const modalUrlInput = document.getElementById('modalUrlInput');

    const MAX_RECENTS = 10; // Show 10 items

    // Load recents from server
    async function loadRecents() {
      try {
        const recents = {{{json recentHistory}}};
        renderRecents(recents);
      } catch (error) {
        console.error('Error loading recents:', error);
        recentsList.innerHTML = '<div class="item" style="color: #999;">Failed to load recent items.</div>';
      }
    }

    // Function to render the list to the HTML
    function renderRecents(recents) {
      recentsList.innerHTML = ''; // Clear the list

      if (!recents || recents.length === 0) {
        // Show a placeholder if no items
        recentsList.innerHTML = '<div class="item" style="color: #999;">No recent URLs yet. Add some links to get started!</div>';
        return;
      }

      recents.forEach(item => {
        const itemEl = document.createElement('div');
        itemEl.className = 'item';
        itemEl.textContent = item.itemReference || item.title || 'Untitled';
        // Make item clickable if it has a URL
        if (item.details && item.details.url) {
          itemEl.style.cursor = 'pointer';
          itemEl.onclick = () => {
            window.open(item.details.url, '_blank');
          };
          // Add URL hint on hover
          itemEl.title = item.details.url;
        }
        recentsList.appendChild(itemEl);
      });
    }

    // --- Event Listeners ---

    // Open the modal when "+" is clicked
    // addUrlBtn.addEventListener('click', () => { // <-- REMOVED
    //   addUrlModal.style.display = 'flex';
    //   modalUrlInput.focus();
    // });

    // Handle the form submission
    addUrlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const title = modalTitleInput.value || 'Untitled';
      const url = modalUrlInput.value;

      if (!url) return; // Don't save if URL is empty

      try {
        // Add to favorites (which will automatically create history entry)
        await fetch('/favorites/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, url })
        });
        
        // Reload page to show updated recents
        window.location.reload();
      } catch (error) {
        console.error('Error adding URL:', error);
        alert('Failed to add URL');
      }

      // Close modal and reset form
      addUrlModal.style.display = 'none';
      addUrlForm.reset();
    });

    // Run on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadRecents(); // Load and display recents when the page opens
      
      // Set up static modal close buttons
      document.querySelectorAll('.modal-box .btn-secondary').forEach(btn => {
        btn.onclick = (e) => {
          e.preventDefault();
          btn.closest('.modal').style.display = 'none';
        }
      });
      document.querySelector('#addUrlModal .btn-secondary').onclick = () => {
        addUrlModal.style.display = 'none';
      }
      document.querySelector('#addUrlModal .close').onclick = () => {
        addUrlModal.style.display = 'none';
      }
    });

  </script>
</body>

</html>