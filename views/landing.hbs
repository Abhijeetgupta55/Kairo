<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #ffffff;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      line-height: 1.6;
      background-image:
        linear-gradient(to right, #e5e5e5 1px, transparent 1px),
        linear-gradient(to bottom, #e5e5e5 1px, transparent 1px);
      background-size: 30px 30px;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 20% 50%, rgba(173, 216, 230, 0.1) 0%, transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(255, 182, 193, 0.1) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    /* Navbar Styles */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
      z-index: 1000;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 5px;
      transition: all 0.3s;
    }

    .hamburger:hover {
      opacity: 0.7;
    }

    .hamburger span {
      width: 25px;
      height: 3px;
      background: #ffffff;
      border-radius: 3px;
      transition: all 0.3s ease;
    }

    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(8px, 8px);
    }

    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }

    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -7px);
    }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 600;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.5px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .login-btn {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      padding: 0.5rem 1rem;
      border-radius: 10px;
    }

    .login-btn:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.1);
    }

    .signup-btn {
      background: #ffffff;
      color: #000;
      text-decoration: none;
      font-weight: 500;
      padding: 0.5rem 1.2rem;
      border-radius: 10px;
      transition: all 0.3s;
    }

    .signup-btn:hover {
      background: rgba(255, 255, 255, 0.9);
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(255, 255, 255, 0.3);
    }

    /* Sidebar Menu */
    .sidebar {
      position: fixed;
      top: 0;
      left: -300px;
      width: 300px;
      height: 100vh;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 2px 0 30px rgba(0, 0, 0, 0.3);
      transition: left 0.3s ease;
      z-index: 999;
      padding-top: 80px;
    }

    .sidebar.active {
      left: 0;
    }

    .sidebar-links {
      display: flex;
      flex-direction: column;
    }

    .sidebar-links a {
      padding: 1.2rem 2rem;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .sidebar-links a:hover {
      background: rgba(255, 255, 255, 0.1);
      border-left-color: #ffffff;
      color: #ffffff;
    }

    .overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(232, 232, 232, 0.605);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 998;
      backdrop-filter: blur(5px);
    }

    .overlay.active {
      opacity: 1;
      visibility: visible;
    }

    /* Hero Section */
    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 100px 3rem 2rem;
      max-width: 1300px;
      margin: 0 auto;
      gap: 3rem;
      position: relative;
      z-index: 1;
    }

    .hero-content {
      flex: 1;
      max-width: 650px;
      animation: fadeInUp 0.8s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-content h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: 3.2rem;
      font-weight: 800;
      color: #000;
      margin-bottom: 1.2rem;
      line-height: 1.1;
      letter-spacing: -1.5px;
      animation: fadeInUp 0.8s ease-out 0.3s both;
    }

    .hero-content h1 .highlight {
      background: linear-gradient(135deg, #00489b 0%, #000000 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-content p {
      font-size: 1.05rem;
      color: rgba(0, 0, 0, 0.6);
      margin-bottom: 2rem;
      line-height: 1.6;
      animation: fadeInUp 0.8s ease-out 0.4s both;
    }

    .hero-buttons {
      display: flex;
      gap: 1rem;
      animation: fadeInUp 0.8s ease-out 0.5s both;
    }

    .get-started,
    .learn-more {
      padding: 0.9rem 2rem;
      border-radius: 50px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: none;
      font-family: 'Inter', sans-serif;
      position: relative;
      overflow: hidden;
    }

    .get-started {
      background: linear-gradient(135deg, #000000 0%, #333333 100%);
      color: #fff;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .get-started::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s;
    }

    .get-started:hover::before {
      left: 100%;
    }

    .get-started:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .learn-more {
      background: rgba(255, 255, 255, 0.8);
      color: #000;
      border: 2px solid rgba(0, 0, 0, 0.1);
      backdrop-filter: blur(10px);
    }

    .learn-more:hover {
      background: rgba(255, 255, 255, 1);
      border-color: rgba(0, 0, 0, 0.2);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .hero-illustration {
      flex: 0.9;
      position: relative;
      animation: fadeInUp 0.8s ease-out 0.6s both;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-visual {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 20px;
      padding: 1.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      max-width: 500px;
    }

    .hero-visual::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: conic-gradient(from 0deg, transparent, rgba(173, 216, 230, 0.1), transparent 30%);
      animation: rotate 10s linear infinite;
    }

    @keyframes rotate {
      100% { transform: rotate(360deg); }
    }

    .hero-visual:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.15);
    }

    .hero-visual img {
      max-width: 100%;
      max-height: 400px;
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
      position: relative;
      z-index: 1;
      transition: transform 0.3s ease;
    }

    .hero-visual:hover img {
      transform: scale(1.02);
    }

    /* Features Section */
    .features {
      padding: 5rem 3rem;
      max-width: 1300px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .features-header {
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .features-header h2 {
      font-family: 'Montserrat', sans-serif;
      font-size: 2.5rem;
      font-weight: 800;
      color: #000;
      margin-bottom: 0.8rem;
      letter-spacing: -1px;
    }

    .features-header p {
      font-size: 1.05rem;
      color: rgba(0, 0, 0, 0.6);
      max-width: 600px;
      margin: 0 auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .feature-card {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      padding: 2rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #667eea, #764ba2);
      transform: scaleX(0);
      transition: transform 0.3s ease;
    }

    .feature-card:hover::before {
      transform: scaleX(1);
    }

    .feature-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
      border-color: rgba(0, 0, 0, 0.15);
    }

    .feature-icon {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.2rem;
      position: relative;
    }

    /* Collection Icon */
    .feature-card:nth-child(1) .feature-icon::before {
      content: '';
      width: 24px;
      height: 24px;
      border: 3px solid #667eea;
      border-radius: 4px;
      box-shadow: inset 0 0 0 2px rgba(102, 126, 234, 0.3);
    }

    /* Star Icon */
    .feature-card:nth-child(2) .feature-icon::before {
      content: '★';
      font-size: 1.8rem;
      color: #667eea;
      font-weight: normal;
    }

    /* Note Icon */
    .feature-card:nth-child(3) .feature-icon::before {
      content: '';
      width: 20px;
      height: 24px;
      border: 3px solid #667eea;
      border-radius: 2px;
      box-shadow: inset 0 8px 0 0 rgba(102, 126, 234, 0.3),
                  inset 0 14px 0 0 rgba(102, 126, 234, 0.3);
    }

    /* Clock Icon */
    .feature-card:nth-child(4) .feature-icon::before {
      content: '';
      width: 24px;
      height: 24px;
      border: 3px solid #667eea;
      border-radius: 50%;
      box-shadow: inset 0 -10px 0 -8px #667eea,
                  inset 8px 0 0 -6px #667eea;
    }

    /* Search Icon */
    .feature-card:nth-child(5) .feature-icon::before {
      content: '';
      width: 18px;
      height: 18px;
      border: 3px solid #667eea;
      border-radius: 50%;
      box-shadow: 8px 8px 0 -2px #667eea;
    }

    /* Palette Icon */
    .feature-card:nth-child(6) .feature-icon::before {
      content: '';
      width: 24px;
      height: 24px;
      border: 3px solid #667eea;
      border-radius: 50%;
      background: radial-gradient(circle at 8px 8px, #667eea 3px, transparent 3px),
                  radial-gradient(circle at 16px 8px, #667eea 3px, transparent 3px),
                  radial-gradient(circle at 12px 16px, #667eea 3px, transparent 3px);
    }

    .feature-card h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #000;
      margin-bottom: 0.8rem;
    }

    .feature-card p {
      font-size: 0.95rem;
      color: rgba(0, 0, 0, 0.6);
      line-height: 1.6;
    }

    /* Discover Section */
    .discover {
      padding: 5rem 3rem;
      max-width: 1300px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 3.5rem;
      position: relative;
      z-index: 1;
    }

    .discover-illustration {
      flex: 0.85;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .discover-visual {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 20px;
      padding: 1.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
      transition: all 0.4s ease;
      max-width: 450px;
    }

    .discover-visual:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.15);
    }

    .discover-visual img {
      max-width: 100%;
      max-height: 350px;
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
      transition: transform 0.3s ease;
    }

    .discover-visual:hover img {
      transform: scale(1.02);
    }

    .discover-content {
      flex: 1;
    }

    .discover-content h2 {
      font-family: 'Montserrat', sans-serif;
      font-size: 2.3rem;
      font-weight: 800;
      color: #000;
      margin-bottom: 1.2rem;
      letter-spacing: -1px;
    }

    .discover-content p {
      font-size: 1.05rem;
      color: rgba(0, 0, 0, 0.6);
      margin-bottom: 1.2rem;
      line-height: 1.7;
    }

    /* About Section */
    .about {
      padding: 5rem 3rem;
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    .about-content {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
    }

    .about-content:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.15);
    }

    .about h2 {
      font-family: 'Montserrat', sans-serif;
      font-size: 2.3rem;
      font-weight: 800;
      color: #000;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .about p {
      font-size: 1.05rem;
      color: rgba(0, 0, 0, 0.6);
      margin-bottom: 1.2rem;
      line-height: 1.7;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Connect Section */
    .connect {
      padding: 5rem 3rem;
      max-width: 800px;
      margin: 0 auto 4rem;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    .connect-content {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
    }

    .connect-content:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.15);
    }

    .connect h3 {
      font-family: 'Montserrat', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: #000;
      margin-bottom: 0.8rem;
      letter-spacing: -1px;
    }

    .connect p {
      font-size: 1.05rem;
      color: rgba(0, 0, 0, 0.6);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .connect form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 480px;
      margin: 0 auto;
    }

    .connect input,
    .connect textarea {
      padding: 0.9rem 1.2rem;
      border: 2px solid rgba(0, 0, 0, 0.08);
      border-radius: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      transition: all 0.3s;
      background: rgba(255, 255, 255, 0.8);
    }

    .connect textarea {
      resize: vertical;
      min-height: 100px;
    }

    .connect input:focus,
    .connect textarea:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
      background: #ffffff;
    }

    .connect button {
      padding: 0.9rem 2rem;
      background: linear-gradient(135deg, #000000 0%, #333333 100%);
      color: #fff;
      border: none;
      border-radius: 50px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      font-family: 'Inter', sans-serif;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .connect button:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .connect button:active {
      transform: translateY(0);
    }

    /* Footer */
    footer {
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.3);
      padding: 2rem;
      text-align: center;
      margin-top: 3rem;
    }

    .lan-footer-links {
      list-style: none;
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .lan-footer-links a {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: all 0.3s;
    }

    .lan-footer-links a:hover {
      color: #ffffff;
    }

    /* Modal Styles */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      z-index: 1001;
      overflow-y: auto;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 0, 0, 0.1);
      padding: 3rem;
      border-radius: 20px;
      max-width: 700px;
      width: 90%;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      position: relative;
    }

    .modal-content h2 {
      color: #000;
      margin-bottom: 1.5rem;
      font-size: 2rem;
    }

    .modal-content p {
      color: rgba(0, 0, 0, 0.7);
      margin-bottom: 1rem;
      line-height: 1.8;
    }

    .close {
      position: absolute;
      top: 1.5rem;
      right: 2rem;
      font-size: 2rem;
      color: rgba(0, 0, 0, 0.5);
      text-decoration: none;
      transition: color 0.3s;
    }

    .close:hover {
      color: #000;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .hero,
      .discover {
        flex-direction: column;
        text-align: center;
      }

      .hero-content h1 {
        font-size: 2.5rem;
      }

      .hero-illustration,
      .discover-illustration {
        order: -1;
      }
    }

    @media (max-width: 768px) {
      nav {
        padding: 1rem 1.5rem;
      }

      .hero,
      .discover,
      .about,
      .connect {
        padding: 3rem 1.5rem;
      }

      .hero-content h1 {
        font-size: 2rem;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .get-started,
      .learn-more {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <nav>
    <div class="nav-left">
      <div class="hamburger" onclick="toggleSidebar()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <a href="/" class="nav-logo">kairo.</a>
    </div>
    <div class="nav-right">
      <a href="/login" class="login-btn">login</a>
      <a href="/signup" class="signup-btn">sign up</a>
    </div>
  </nav>

  <div class="sidebar" id="sidebar">
    <div class="sidebar-links">
      <a href="#hero">home</a>
      <a href="#discover">discover</a>
      <a href="#about">about us</a>
      <a href="#connect">contact</a>
      <a href="/login">login</a>
    </div>
  </div>

  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <section class="hero" id="hero">
    <div class="hero-content">
