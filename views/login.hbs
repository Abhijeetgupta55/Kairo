<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #ffffff;
            min-height: 100vh;
            display: flex;
            position: relative;
            overflow: hidden;
            line-height: 1.6;
            background-image:
                linear-gradient(to right, #d8d8d886 1px, transparent 1px),
                linear-gradient(to bottom, #d8d8d886 1px, transparent 1px);
            background-size: 20px 20px;
        }
        
        .l-container {
            display: flex;
            width: 100vw;
            height: 100vh;
            position: relative;
            z-index: 1;
        }
        
        @keyframes circularGradientShift {
            0%   { background-position: 0% 50%; }
            25%  { background-position: 50% 0%; }
            50%  { background-position: 100% 50%; }
            75%  { background-position: 50% 100%; }
            100% { background-position: 0% 50%; }
        }

        .l-left {
            flex: 0 0 50%; 
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 3rem;
            overflow: hidden;
            box-shadow: 4px 0 30px rgba(0, 0, 0, 0.5);
            background-image: none; 
            animation: none;
        }

        .l-left::before {
             content: '';
             position: absolute;
             top: 0;
             left: 0;
             width: 100%;
             height: 100%;
             background: 
                radial-gradient(circle at 15% 50%, rgb(89, 89, 89) 0%, transparent 50%),
                radial-gradient(circle at 85% 50%, rgb(53, 53, 53) 0%, transparent 60%),
                radial-gradient(circle at 50% 15%, rgba(0, 0, 0, 0.8) 0%, transparent 70%),
                radial-gradient(circle at 50% 85%, rgba(0, 0, 0, 1) 0%, transparent 50%),
                radial-gradient(circle at 70% 30%, rgba(62, 62, 62, 0.15) 0%, transparent 60%);
             background-size: 300% 300%; 
             animation: circularGradientShift 50s ease infinite;
             pointer-events: none;
        }
        
        .l-left::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            100% { transform: rotate(360deg); }
        }

        .l-left h1 {
            font-size: 5rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -3px;
            text-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
            position: relative;
            z-index: 1;
        }

        .l-right {
            flex: 0 0 50%; 
            padding: 8vh 4rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            background: transparent;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .l-right h2 {
            font-size: 2.2rem; 
            font-weight: 700;
            color: #000000;
            margin-bottom: 0.2rem; 
            letter-spacing: -0.5px;
        }

        .l-input-group {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .l-input-group label {
            display: block;
            font-size: 0.8rem; 
            font-weight: 600;
            color: #000000;
            margin-bottom: 0.4rem; 
        }

        .l-input-group input {
            width: 100%;
            padding: 0.9rem 1.2rem; 
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 8px; 
            font-size: 0.95rem; 
            font-family: 'Inter', sans-serif;
            transition: all 0.3s;
            background: rgba(255, 255, 255, 0.9);
        }

        .l-input-group input:focus {
            outline: none;
            border-color: #4A90E2;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.1);
        }

        .l-btn {
            width: 100%;
            padding: 0.9rem; 
            background: #000000;
            color: #fff;
            border: none;
            border-radius: 8px; 
            font-size: 1rem; 
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: block;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            font-family: 'Inter', sans-serif;
        }

        .l-btn:hover {
            background: #333333;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }
        
        .l-social-login {
            text-align: center;
            margin: 2rem 0 1rem; 
            font-size: 0.9rem; 
            color: rgba(0, 0, 0, 0.5);
        }

        .l-social-icons {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-bottom: 2rem; 
        }

        .l-social-icons i {
            width: 45px; 
            height: 45px; 
            border-radius: 50%;
            border: 1px solid rgba(0, 0, 0, 0.15);
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1.2rem; 
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
            color: #333; 
        }

        .l-social-icons i:hover {
            border-color: #000;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .l-signup {
            text-align: center;
            font-size: 0.9rem; 
            color: rgba(0, 0, 0, 0.6);
        }

        .l-signup a {
            color: #000;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.3s;
        }

        .l-signup a:hover {
            color: #4A90E2;
            text-decoration: underline;
        }

        .error-message {
            background: linear-gradient(135deg, #D32F2F 0%, #B71C1C 100%);
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            font-size: 0.95rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        @media (max-width: 968px) {
            .l-container {
                flex-direction: column;
            }

            .l-left {
                min-height: 25vh; 
                flex: 0 0 auto;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

            .l-left h1 {
                font-size: 3.5rem;
            }

            .l-right {
                flex: 1;
                padding: 3rem 2rem;
                max-width: 100%;
                overflow-y: visible; 
            }
        }
    </style>
</head>

<body>
    <div class="l-container">
        <div class="l-left">
            <h1>kairo.</h1>
        </div>

        <div class="l-right">
            <h2>Welcome back!</h2>

            {{#if error}}
            <div class="error-message">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>{{error}}</span>
            </div>
            {{/if}}

            <form method="POST" action="/login">
                <div class="l-input-group">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" placeholder="Type your e-mail" value="{{email}}" required>
                </div>

                <div class="l-input-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Type your password" required>
                </div>
                
                <button type="submit" class="l-btn">Sign In</button>
            </form>

            <div class="l-social-login">or do it via other accounts</div>
            <div class="l-social-icons">
                <i class="fa-brands fa-google" aria-label="Login with Google"></i>
                <i class="fa-brands fa-apple" aria-label="Login with Apple"></i>
                <i class="fa-brands fa-facebook-f" aria-label="Login with Facebook"></i>
            </div>

            <div class="l-signup">
                Don't have an account? <a href="/signup">Sign Up</a>
            </div>
        </div>
    </div>
</body>
</html>
