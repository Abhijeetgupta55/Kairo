<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>kairo. - favorites</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #ffffff;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      line-height: 1.6;
      background-image:
        linear-gradient(to right, #d8d8d886 1px, transparent 1px),
        linear-gradient(to bottom, #d8d8d886 1px, transparent 1px);
      background-size: 20px 20px;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: 
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.482) 0%, transparent 40%),
        radial-gradient(circle at 90% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
      z-index: 1000;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 5px;
      transition: all 0.3s;
    }

    .hamburger:hover { opacity: 0.7; }

    .hamburger span {
      width: 25px;
      height: 3px;
      background: #ffffff;
      border-radius: 3px;
      transition: all 0.3s ease;
    }

    .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(8px, 8px); }
    .hamburger.active span:nth-child(2) { opacity: 0; }
    .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(7px, -7px); }

    .nav-logo {
      font-size: 1.5rem;
      font-weight: 600;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.5px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .logout-btn {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s;
      padding: 0.5rem 1rem;
      border-radius: 10px;
    }

    .logout-btn:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.1);
    }

    .profile-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #ffffff93;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
    }

    .profile-icon:hover {
      transform: scale(1.1);
      box-shadow: 0 0 0 3px rgba(185, 185, 185, 0.3);
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: -300px;
      width: 300px;
      height: 100vh;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 2px 0 30px rgba(0, 0, 0, 0.3);
      transition: left 0.3s ease;
      z-index: 999;
      padding-top: 80px;
    }

    .sidebar.active { left: 0; }

    .sidebar-links {
      display: flex;
      flex-direction: column;
    }

    .sidebar-links a {
      padding: 1.2rem 2rem;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .sidebar-links a:hover {
      background: rgba(255, 255, 255, 0.1);
      border-left-color: #ffffff;
      color: #ffffff;
    }

    .overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(232, 232, 232, 0.605);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      z-index: 998;
      backdrop-filter: blur(5px);
    }

    .overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 100px 2rem 2rem;
      position: relative;
      z-index: 1;
    }

    h1.page-heading {
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      text-transform: lowercase;
      display: flex;
      align-items: center;
      gap: .5rem;
    }

    h1.page-heading span {
      color: #f5b400;
    }

    .favorites-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .favorite-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .favorite-card:hover {
      background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(245, 180, 0, 0.3);
      border-color: rgba(245, 180, 0, 0.4);
    }

    .favorite-title {
      font-size: 1rem;
      font-weight: 500;
      margin-bottom: .5rem;
      text-transform: lowercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .favorite-url {
      font-size: .85rem;
      color: #666;
      text-decoration: none;
      word-break: break-word;
    }

    .favorite-url:hover {
      color: #1a1a1a;
    }

    .favorite-timestamp {
      font-size: .8rem;
      color: #999;
      margin-top: .6rem;
    }

    .star {
      font-size: 1.2rem;
      color: #f5b400;
      cursor: pointer;
      transition: all 0.3s;
    }

    .star:hover {
      transform: scale(1.2);
    }

    .favorite-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .delete-btn {
      font-size: 1rem;
      color: #999;
      cursor: pointer;
      transition: all 0.3s;
      background: none;
      border: none;
      padding: 0;
    }

    .delete-btn:hover {
      color: #ff4444;
      transform: scale(1.2);
    }

    .add-favorite-btn {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #f5b400;
      color: white;
      font-size: 2rem;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(245, 180, 0, 0.4);
      transition: all 0.3s;
      z-index: 100;
    }

    .add-favorite-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 30px rgba(245, 180, 0, 0.6);
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(5px);
      z-index: 2000;
      justify-content: center;
      align-items: center;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: white;
      border-radius: 12px;
      padding: 2rem;
      max-width: 500px;
      width: 90%;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      text-transform: lowercase;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      text-transform: lowercase;
    }

    .form-group input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
    }

    .form-group input:focus {
      outline: none;
      border-color: #f5b400;
      box-shadow: 0 0 0 3px rgba(245, 180, 0, 0.1);
    }

    .modal-actions {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .modal-btn {
      flex: 1;
      padding: 0.75rem;
      border: none;
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s;
      text-transform: lowercase;
    }

    .modal-btn.primary {
      background: #f5b400;
      color: white;
    }

    .modal-btn.primary:hover {
      background: #e0a500;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(245, 180, 0, 0.3);
    }

    .modal-btn.secondary {
      background: #f5f5f5;
      color: #333;
    }

    .modal-btn.secondary:hover {
      background: #e0e0e0;
    }

    .search-container {
      margin-bottom: 2rem;
    }

    .search-input {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
    }

    .search-input:focus {
      outline: none;
      border-color: #f5b400;
      box-shadow: 0 0 0 3px rgba(245, 180, 0, 0.1);
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: #999;
    }

    .empty-state-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    footer {
      position: relative;
      text-align: center;
      padding: 2rem;
      color: rgba(255, 255, 255, 0.8);
      margin-top: 3rem;
      z-index: 1;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.3);
    }

    @media (max-width: 768px) {
      .container {
        padding: 100px 1rem 2rem;
      }
      .favorites-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <nav>
    <div class="nav-left">
      <div class="hamburger" onclick="toggleSidebar()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <a href="/dashboard" class="nav-logo">kairo.</a>
    </div>
    <div class="nav-right">
      <a href="/logout" class="logout-btn">logout</a>
      <a href="/profile" class="profile-icon">{{#if user.username}}{{substring user.username 0 1}}{{else}}F{{/if}}</a>
    </div>
  </nav>

  <div class="sidebar" id="sidebar">
    <div class="sidebar-links">
      <a href="/dashboard">dashboard</a>
      <a href="/recent">recents</a>
      <a href="/notes">notes</a>
      <a href="/favorites">favorites</a>
      <a href="/collections">collections</a>
      <a href="/profile">profile</a>
    </div>
  </div>

  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <div class="container">
    <h1 class="page-heading">🌟 <span>favorites</span></h1>
    
    <div class="search-container">
      <input type="text" class="search-input" id="searchInput" placeholder="search favorites...">
    </div>

    <div class="favorites-grid" id="favoritesGrid">
      <!-- Favorites will be loaded here -->
    </div>

    <div class="empty-state" id="emptyState" style="display: none;">
      <div class="empty-state-icon">⭐</div>
      <p>no favorites yet. click the + button to add your first favorite!</p>
    </div>
  </div>

  <button class="add-favorite-btn" onclick="openAddModal()">+</button>

  <!-- Add Favorite Modal -->
  <div class="modal" id="addModal">
    <div class="modal-content">
      <h2 class="modal-header">add favorite</h2>
      <form id="addFavoriteForm">
        <div class="form-group">
          <label for="favoriteTitle">title</label>
          <input type="text" id="favoriteTitle" required>
        </div>
        <div class="form-group">
          <label for="favoriteUrl">url</label>
          <input type="url" id="favoriteUrl" required>
        </div>
        <div class="form-group">
          <label for="favoriteFavicon">favicon url (optional)</label>
          <input type="url" id="favoriteFavicon">
        </div>
        <div class="modal-actions">
          <button type="button" class="modal-btn secondary" onclick="closeAddModal()">cancel</button>
          <button type="submit" class="modal-btn primary">add favorite</button>
        </div>
      </form>
    </div>
  </div>

  <footer>
    <p>©2025 kairo. All rights reserved.</p>
  </footer>

  <script>
    let favorites = [];
    let filteredFavorites = [];

    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      const hamburger = document.querySelector('.hamburger');
      
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
      hamburger.classList.toggle('active');
    }

    async function loadFavorites() {
      try {
        const response = await fetch('/favorites/api');
        if (!response.ok) throw new Error('Failed to load favorites');
        
        favorites = await response.json();
        filteredFavorites = [...favorites];
        renderFavorites();
      } catch (error) {
        console.error('Error loading favorites:', error);
      }
    }

    function renderFavorites() {
      const grid = document.getElementById('favoritesGrid');
      const emptyState = document.getElementById('emptyState');
      
      if (filteredFavorites.length === 0) {
        grid.style.display = 'none';
        emptyState.style.display = 'block';
        return;
      }
      
      grid.style.display = 'grid';
      emptyState.style.display = 'none';
      
      grid.innerHTML = filteredFavorites.map(fav => {
        const starIcon = fav.isStarred ? '★' : '☆';
        const timeAgo = getTimeAgo(new Date(fav.createdAt));
        
        return `
          <div class="favorite-card">
            <h3 class="favorite-title">
              ${escapeHtml(fav.title)}
              <div class="favorite-actions">
                <span class="star" onclick="toggleStar('${fav._id}')">${starIcon}</span>
                <button class="delete-btn" onclick="deleteFavorite('${fav._id}')">✕</button>
              </div>
            </h3>
            <a href="${escapeHtml(fav.url)}" target="_blank" class="favorite-url">${escapeHtml(fav.url)}</a>
            <div class="favorite-timestamp">added ${timeAgo}</div>
          </div>
        `;
      }).join('');
    }

    async function addFavorite(event) {
      event.preventDefault();
      
      const title = document.getElementById('favoriteTitle').value;
      const url = document.getElementById('favoriteUrl').value;
      const favicon = document.getElementById('favoriteFavicon').value;
      
      try {
        const response = await fetch('/favorites/api', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ title, url, favicon })
        });
        
        if (!response.ok) throw new Error('Failed to add favorite');
        
        await loadFavorites();
        closeAddModal();
        document.getElementById('addFavoriteForm').reset();
      } catch (error) {
        console.error('Error adding favorite:', error);
        alert('Failed to add favorite. Please try again.');
      }
    }

    async function deleteFavorite(id) {
      if (!confirm('Are you sure you want to delete this favorite?')) return;
      
      try {
        const response = await fetch(`/favorites/api/${id}`, {
          method: 'DELETE'
        });
        
        if (!response.ok) throw new Error('Failed to delete favorite');
        
        await loadFavorites();
      } catch (error) {
        console.error('Error deleting favorite:', error);
        alert('Failed to delete favorite. Please try again.');
      }
    }

    async function toggleStar(id) {
      try {
        const response = await fetch(`/favorites/api/${id}/toggle-star`, {
          method: 'POST'
        });
        
        if (!response.ok) throw new Error('Failed to toggle star');
        
        await loadFavorites();
      } catch (error) {
        console.error('Error toggling star:', error);
      }
    }

    function openAddModal() {
      document.getElementById('addModal').classList.add('active');
    }

    function closeAddModal() {
      document.getElementById('addModal').classList.remove('active');
      document.getElementById('addFavoriteForm').reset();
    }

    function searchFavorites(query) {
      const searchTerm = query.toLowerCase();
      filteredFavorites = favorites.filter(fav => 
        fav.title.toLowerCase().includes(searchTerm) || 
        fav.url.toLowerCase().includes(searchTerm)
      );
      renderFavorites();
    }

    function getTimeAgo(date) {
      const seconds = Math.floor((new Date() - date) / 1000);
      
      const intervals = {
        year: 31536000,
        month: 2592000,
        week: 604800,
        day: 86400,
        hour: 3600,
        minute: 60
      };
      
      for (const [unit, secondsInUnit] of Object.entries(intervals)) {
        const interval = Math.floor(seconds / secondsInUnit);
        if (interval >= 1) {
          return `${interval} ${unit}${interval === 1 ? '' : 's'} ago`;
        }
      }
      
      return 'just now';
    }

    function escapeHtml(text) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      };
      return text.replace(/[&<>"']/g, m => map[m]);
    }

    // Event listeners
    document.getElementById('addFavoriteForm').addEventListener('submit', addFavorite);
    document.getElementById('searchInput').addEventListener('input', (e) => searchFavorites(e.target.value));

    // Close modal on outside click
    document.getElementById('addModal').addEventListener('click', (e) => {
      if (e.target.id === 'addModal') {
        closeAddModal();
      }
    });

    // Load favorites on page load
    loadFavorites();
  </script>

</body>
</html>